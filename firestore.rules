rules_version = '2';

// =============================================================================
// Firestore Security Rules — PakaiLagi
//
// Struktur data:
//   profiles/{uid}                    privat: hanya pemilik akun
//   items/{itemId}                    publik (perlu login): TANPA alamat lengkap,
//                                     hanya kelurahan & kota
//   items/{itemId}/private/location   alamat lengkap + koordinat GPS:
//                                     pemilik & peminta yang diterima
//   pickupRequests/{itemId}_{uid}     pengajuan: peminta & pemilik barang
//   notifications/{id}                hanya penerima yang bisa membaca
//
// Deploy: firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function itemPath(itemId) {
      return /databases/$(database)/documents/items/$(itemId);
    }

    function requestPath(itemId, requesterId) {
      return /databases/$(database)/documents/pickupRequests/$(itemId + '_' + requesterId);
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    // Peminta yang pengajuannya sudah diterima pemilik barang.
    function isAcceptedRequester(itemId) {
      let path = requestPath(itemId, uid());
      return exists(path) && get(path).data.status == 'accepted';
    }

    function validAdditionalImages(data) {
      return !('additionalImages' in data)
        || (data.additionalImages is list
            && data.additionalImages.size() <= 4
            && (data.additionalImages.size() < 1
                || (data.additionalImages[0] is string
                    && data.additionalImages[0].size() < 175000))
            && (data.additionalImages.size() < 2
                || (data.additionalImages[1] is string
                    && data.additionalImages[1].size() < 175000))
            && (data.additionalImages.size() < 3
                || (data.additionalImages[2] is string
                    && data.additionalImages[2].size() < 175000))
            && (data.additionalImages.size() < 4
                || (data.additionalImages[3] is string
                    && data.additionalImages[3].size() < 175000)));
    }

    // -------------------------------------------------------------------------
    // PROFIL — berisi nama, email, nomor HP, alamat lengkap, koordinat.
    // -------------------------------------------------------------------------
    match /profiles/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // -------------------------------------------------------------------------
    // BARANG
    // -------------------------------------------------------------------------
    match /items/{itemId} {
      allow read: if signedIn();

      // Field alamat lengkap/koordinat tidak termasuk daftar ini, sehingga
      // tidak mungkin tersimpan di dokumen publik.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'title', 'category', 'description', 'imageBase64', 'additionalImages', 'donorId',
             'ownerName', 'kelurahan', 'kota', 'pickupMethods', 'condition',
             'listingType', 'price', 'status', 'createdAt'])
        // pickupMethods opsional (barang lama tidak punya). Bila ada: daftar
        // berisi 1–5 nama metode berupa teks.
        && (!('pickupMethods' in request.resource.data)
            || (request.resource.data.pickupMethods is list
                && request.resource.data.pickupMethods.size() >= 1
                && request.resource.data.pickupMethods.size() <= 5))
        && request.resource.data.donorId == uid()
        && request.resource.data.status == 'available'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.ownerName is string
        && request.resource.data.kelurahan is string
        && request.resource.data.kota is string
        && request.resource.data.imageBase64 is string
        && request.resource.data.condition in ['Seperti Baru', 'Sangat Layak', 'Layak Pakai']
        && request.resource.data.listingType in ['gratis', 'tebus_murah']
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 50000
        && (request.resource.data.listingType == 'tebus_murah'
            || request.resource.data.price == 0)
        && request.resource.data.imageBase64.size() < 900000
        && validAdditionalImages(request.resource.data)
        // Galeri: cover + hingga empat foto, tiap Base64 string <175 KB.
        // Batas ini membuat total payload foto tidak melewati 875 KB.
        && (!('additionalImages' in request.resource.data)
            || request.resource.data.additionalImages.size() == 0
            || request.resource.data.imageBase64.size() < 175000)
        && request.resource.data.createdAt == request.time;

      // Pemilik hanya boleh mengubah status.
      allow update: if signedIn()
        && resource.data.donorId == uid()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['available', 'reserved', 'completed'];

      allow delete: if signedIn() && resource.data.donorId == uid();

      // Alamat lengkap barang.
      match /private/{docId} {
        allow read: if signedIn()
          && (get(itemPath(itemId)).data.donorId == uid()
              || isAcceptedRequester(itemId));

        // getAfter: dokumen ini ditulis dalam batch yang sama dengan
        // pembuatan item, jadi kepemilikan dicek pada keadaan setelah batch.
        allow create, update: if signedIn()
          && docId == 'location'
          && getAfter(itemPath(itemId)).data.donorId == uid()
          && request.resource.data.keys().hasOnly(['address', 'latitude', 'longitude'])
          && request.resource.data.address is string;

        // get (bukan getAfter): item dihapus dalam batch yang sama.
        allow delete: if signedIn() && get(itemPath(itemId)).data.donorId == uid();
      }
    }

    // -------------------------------------------------------------------------
    // PENGAJUAN PENGAMBILAN — ID dokumen: {itemId}_{requesterId}
    // -------------------------------------------------------------------------
    match /pickupRequests/{requestId} {
      // resource == null: peminta boleh mengecek apakah ia sudah mengajukan.
      allow get: if signedIn()
        && (resource == null
            || uid() == resource.data.requesterId
            || uid() == resource.data.ownerId);

      // Query wajib memfilter requesterId == uid atau ownerId == uid.
      allow list: if signedIn()
        && (uid() == resource.data.requesterId || uid() == resource.data.ownerId);

      allow create: if signedIn()
        && requestId == request.resource.data.itemId + '_' + uid()
        && request.resource.data.keys().hasOnly([
             'itemId', 'ownerId', 'requesterId', 'requesterName', 'method',
             'status', 'createdAt', 'reason'])
        && request.resource.data.requesterId == uid()
        && request.resource.data.status == 'pending'
        && (!('reason' in request.resource.data)
            || (request.resource.data.reason is string
                && request.resource.data.reason.size() <= 240))
        && request.resource.data.ownerId != uid()
        && request.resource.data.ownerId
             == get(itemPath(request.resource.data.itemId)).data.donorId
        && get(itemPath(request.resource.data.itemId)).data.status == 'available'
        && request.resource.data.createdAt == request.time;

      // Pemilik memutuskan pengajuan yang masih pending. Menerima pengajuan
      // hanya sah bila barang masih tersedia dan diubah menjadi reserved
      // dalam batch yang sama (mencegah dua pengajuan sama-sama diterima).
      allow update: if signedIn()
        && uid() == resource.data.ownerId
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedAt'])
        && (request.resource.data.status == 'rejected'
            || (request.resource.data.status == 'accepted'
                && get(itemPath(resource.data.itemId)).data.status == 'available'
                && getAfter(itemPath(resource.data.itemId)).data.status == 'reserved'));

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // NOTIFIKASI
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == uid();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'recipientId', 'senderName', 'title', 'body', 'itemId', 'isRead',
             'createdAt'])
        && request.resource.data.isRead == false
        && request.resource.data.recipientId is string
        && request.resource.data.itemId is string
        && (
             // Peminta memberi tahu pemilik saat mengajukan.
             (request.resource.data.recipientId
                  == get(itemPath(request.resource.data.itemId)).data.donorId
              && existsAfter(requestPath(request.resource.data.itemId, uid())))
             ||
             // Pemilik memberi tahu peminta tentang keputusannya.
             (get(itemPath(request.resource.data.itemId)).data.donorId == uid()
              && exists(requestPath(request.resource.data.itemId,
                                    request.resource.data.recipientId)))
           );

      allow update: if signedIn()
        && resource.data.recipientId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // CHAT — ID dokumen: {itemId}_{requesterId}
    // Hanya pemilik barang dan peminta yang dapat membaca & mengirim pesan.
    // -------------------------------------------------------------------------
    match /chats/{chatId} {
      allow get: if signedIn()
        && (resource == null || uid() in resource.data.participants);

      allow list: if signedIn() && uid() in resource.data.participants;

      allow create: if signedIn()
        && chatId == request.resource.data.itemId + '_' + request.resource.data.requesterId
        && request.resource.data.keys().hasOnly([
             'itemId', 'itemTitle', 'ownerId', 'ownerName',
             'requesterId', 'requesterName', 'participants',
             'lastMessage', 'lastSenderId', 'lastMessageAt',
             'ownerUnread', 'requesterUnread'])
        && request.resource.data.ownerId != request.resource.data.requesterId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.ownerId in request.resource.data.participants
        && request.resource.data.requesterId in request.resource.data.participants
        && uid() in request.resource.data.participants
        && request.resource.data.ownerId
             == get(itemPath(request.resource.data.itemId)).data.donorId
        && request.resource.data.lastSenderId == uid()
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 1000;

      allow update: if signedIn()
        && uid() in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'lastMessage', 'lastSenderId', 'lastMessageAt',
             'ownerUnread', 'requesterUnread'])
        && (
             (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['ownerUnread'])
              && uid() == resource.data.ownerId
              && request.resource.data.ownerUnread == 0)
             ||
             (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['requesterUnread'])
              && uid() == resource.data.requesterId
              && request.resource.data.requesterUnread == 0)
             ||
             (request.resource.data.lastSenderId == uid()
              && request.resource.data.lastMessage is string
              && request.resource.data.lastMessage.size() > 0
              && request.resource.data.lastMessage.size() <= 1000)
           );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && exists(chatPath(chatId))
          && uid() in get(chatPath(chatId)).data.participants;

        allow create: if signedIn()
          && uid() in getAfter(chatPath(chatId)).data.participants
          && request.resource.data.keys().hasOnly([
               'senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == uid()
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
